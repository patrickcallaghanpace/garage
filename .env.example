# Copy this file to .env.local and fill in what you have.
# The app runs in degraded-but-functional mode for anything left blank —
# see docs/SETUP.md for how to obtain each value from scratch.

# --- Supabase (required for the app to function at all) -------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform (required for the scheduling engine) ------------
# Needs Geocoding API + Distance Matrix API enabled, with billing on the
# Google Cloud project. Server-side only.
GOOGLE_MAPS_API_KEY=

# --- App -------------------------------------------------------------------
# Public base URL used to build links in emails/WhatsApp messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email via Resend (optional — booking still works without it) ---------
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Garage Dupont <booking@yourdomain.com>"
RESEND_FROM_EMAIL=

# --- WhatsApp via Twilio (optional — booking still works without it) ------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp-enabled sender, e.g. whatsapp:+14155238886 (sandbox) or your own number
TWILIO_WHATSAPP_FROM=

# --- Daily reminder cron (optional — see vercel.json) ----------------------
# Any long random string. Vercel automatically sends it as a Bearer token
# when triggering /api/cron/reminders; without it, that route stays disabled.
CRON_SECRET=
